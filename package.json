{
  "name": "@frsty/typesafe-query-keys",
  "version": "2.0.1-beta.2",
  "description": "Type-safe query keys for TanStack Query",
  "type": "module",
  "author": "Sandesh Pandey",
  "main": "dist/runtime.js",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bugs": {
    "url": "https://github.com/frstycodes/typesafe-query-keys/issues"
  },
  "homepage": "https://github.com/frstycodes/typesafe-query-keys#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/frstycodes/typesafe-query-keys.git"
  },
  "keywords": [
    "typescript",
    "tanstack-query",
    "query-keys",
    "type-safe",
    "vite-plugin",
    "webpack-plugin",
    "codegen"
  ],
  "exports": {
    ".": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./plugin": {
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./plugin/vite": {
      "import": "./dist/plugins/vite.js",
      "require": "./dist/plugins/vite.cjs"
    },
    "./plugin/webpack": {
      "import": "./dist/plugins/webpack.js",
      "require": "./dist/plugins/webpack.cjs"
    },
    "./plugin/generic": {
      "import": "./dist/plugins/generic.js",
      "require": "./dist/plugins/generic.cjs"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "ci:version": "npm run version",
    "ci:publish": "npm publish --no-git-checks",
    "prepublishOnly": "npm run build",
    "changeset": "cliff-jumper",
    "version": "cliff-jumper version",
    "release": "cliff-jumper release",
    "bump": "pnpm changeset && pnpm version",
    "bump:push": "pnpm bump && git push --follow-tags",
    "push": "git push --follow-tags",
    "commit": "cz"
  },
  "peerDependencies": {
    "typescript": ">=4",
    "vite": ">=3",
    "webpack": ">=3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@effect/platform": "0.94.1",
    "@effect/platform-node": "0.104.0",
    "chokidar": "^4.0.3",
    "effect": "3.19.14",
    "globby": "15.0.0",
    "ignore": "7.0.5",
    "micromatch": "4.0.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@favware/cliff-jumper": "6.0.0",
    "@types/micromatch": "4.0.10",
    "@typescript-eslint/eslint-plugin": "8.39.1",
    "@typescript-eslint/parser": "8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "tsup": "8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "webpack": "5.102.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
